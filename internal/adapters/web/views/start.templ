package views

// Start is the slug form at GET /login: the entry point that sends a visitor
// on to the sign-in page of the business they name.
templ Start(page StartPage) {
	@Layout() {
		<h1>Slotwise</h1>
		<p>Sign in to manage your team's schedule.</p>
		if page.Error != "" {
			<p class="error">{ page.Error }</p>
		}
		<form method="get" action="/login">
			<p>
				<label for="slug">Business slug</label>
				<input id="slug" name="slug" type="text" value={ page.Slug } required/>
			</p>
			<p><button type="submit">Continue</button></p>
		</form>
	}
}
